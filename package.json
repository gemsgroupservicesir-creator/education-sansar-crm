{
  "name": "education-sansar-crm",
  "version": "1.0.0",
  "type": "module",
  "description": "Full-stack Education Admission CRM / Student Recruitment Management System for Gems Group Services",
  "main": "server/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --format=esm --packages=external --bundle --outfile=dist-server/index.js && esbuild server/index.ts --platform=node --format=esm --packages=external --bundle --outfile=api/index.js",
    "build:local": "npm run build:client && npm run build:server",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "start:ts": "NODE_ENV=production tsx server/index.ts",
    "tunnel": "npx localtunnel --port 5001",
    "seed": "tsx server/db/seed.ts",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "concurrently \"vite --port 5173\" \"ELECTRON_DEV=true electron electron/main.cjs\"",
    "build:desktop": "npm run build:client && electron-builder --config electron-builder.json",
    "build:desktop:mac": "npm run build:client && electron-builder --mac --config electron-builder.json",
    "build:desktop:win": "npm run build:client && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vercel": "^65.14.0",
    "vite": "^6.0.7"
  }
}
